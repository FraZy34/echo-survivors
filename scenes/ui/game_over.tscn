[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/game_over_screen.gd" id="1_over"]
[ext_resource type="FontVariation" path="res://resources/ui/title_font.tres" id="2_title"]

[node name="GameOver" type="CanvasLayer"]
process_mode = 3
layer = 30
script = ExtResource("1_over")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.03, 0.02, 0.06, 0.75)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("2_title")
theme_override_font_sizes/font_size = 22
text = "Défaite..."
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.76, 0.9, 1)
theme_override_font_sizes/font_size = 9
text = "Sous-titre"
horizontal_alignment = 1

[node name="Grid" type="GridContainer" parent="Center/Panel/VBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 2
columns = 2

[node name="TimeCaption" type="Label" parent="Center/Panel/VBox/Grid"]
layout_mode = 2
